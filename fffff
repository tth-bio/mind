-- ============================================================
--   Multi-Controller Inventory System (3+ Managers)
--   CC:Tweaked + Advanced Peripherals
-- ============================================================

-- Directions & Peripherals Scanner
local SIDES = { "top", "bottom", "left", "right", "front", "back" }

-- Optional Monitor
local monitor = peripheral.find("monitor")
if monitor then
    pcall(function()
        monitor.setTextScale(0.5)
        monitor.clear()
    end)
end

-- 1. Universal Manager Scanner (Works with Direct Contact AND Wired Modems)
local function getManagers()
    local list = {}
    
    -- Method A: Scan named peripherals (Wired Modems / Network)
    local allNames = peripheral.getNames()
    for _, name in ipairs(allNames) do
        local pType = peripheral.getType(name)
        if pType and (pType == "inventory_manager" or pType == "inventoryManager") then
            local managerObj = peripheral.wrap(name)
            local owner = managerObj.getOwner and managerObj.getOwner()
            if owner and owner ~= "" then
                table.insert(list, {
                    id = name,
                    obj = managerObj,
                    owner = owner
                })
            end
        end
    end

    return list
end

-- 2. Detect Chest / Storage Container
local STORAGE_TYPES = {
    ["minecraft:chest"] = true, ["minecraft:barrel"] = true,
    ["minecraft:trapped_chest"] = true, ["minecraft:shulker_box"] = true,
    ["ironchest:iron_chest"] = true, ["ironchest:gold_chest"] = true,
    ["ironchest:diamond_chest"] = true
}

local chestTarget = nil
for _, name in ipairs(peripheral.getNames()) do
    local pType = peripheral.getType(name)
    if STORAGE_TYPES[pType] or (pType and string.find(pType, "chest")) then
        chestTarget = name
        break
    end
end
if not chestTarget then chestTarget = "top" end

-- 3. Helpers
local function toNum(v) return tonumber(v) or 0 end

local function isSlotInScope(slotNum, scope)
    if scope == "ALL" then return true
    elseif scope == "HOTBAR" then return slotNum >= 0 and slotNum <= 8
    elseif scope == "MAIN" then return slotNum >= 9 and slotNum <= 35
    elseif scope == "ARMOR" then return (slotNum >= 100 and slotNum <= 103) or (slotNum >= 36 and slotNum <= 39)
    elseif scope == "OFFHAND" then return slotNum == 36 or slotNum == 104 end
    return true
end

-- Monitor Updater
local function updateMonitor(managers)
    if not monitor then return end
    pcall(function()
        monitor.clear()
        monitor.setCursorPos(1, 1)
        monitor.setTextColor(colors.yellow)
        monitor.write("=== MULTI-INVENTORY SYSTEM ===")
        monitor.setCursorPos(1, 3)
        monitor.setTextColor(colors.white)
        monitor.write("Connected Controllers: " .. #managers)
        
        for i, m in ipairs(managers) do
            monitor.setCursorPos(1, 4 + i)
            monitor.setTextColor(colors.green)
            monitor.write(string.format("[%d] %s (%s)", i, m.owner, m.id))
        end
    end)
end

-- 4. Core Transfer Functions
local function exportFromPlayer(managerObj, filter, scope)
    scope = scope or "ALL"
    local items = {}
    
    local okList, rawItems = pcall(function() return managerObj.getItems() end)
    if okList and type(rawItems) == "table" then
        for k, v in pairs(rawItems) do table.insert(items, v) end
    end

    if (scope == "ALL" or scope == "ARMOR") and managerObj.getArmor then
        local okArmor, armorItems = pcall(function() return managerObj.getArmor() end)
        if okArmor and type(armorItems) == "table" then
            for k, v in pairs(armorItems) do table.insert(items, v) end
        end
    end

    local totalMoved = 0
    for _, item in pairs(items) do
        if type(item) == "table" and item.count and item.count > 0 then
            local slotNum = toNum(item.slot or item.slotNumber)
            if isSlotInScope(slotNum, scope) then
                local matches = true
                if filter and filter.name and filter.name ~= "" then
                    if item.name ~= filter.name then matches = false end
                end

                if matches then
                    local amount = item.count
                    if filter and filter.count and filter.count > 0 then
                        amount = math.min(amount, filter.count)
                    end
                    local ok, moved = pcall(function()
                        return managerObj.removeItemFromPlayer(chestTarget, {
                            fromSlot = slotNum,
                            count = amount
                        })
                    end)
                    if ok and toNum(moved) > 0 then
                        totalMoved = totalMoved + toNum(moved)
                    end
                end
            end
        end
    end
    return totalMoved
end

local function importToPlayer(managerObj, filter)
    local ok, moved = pcall(function()
        return managerObj.addItemToPlayer(chestTarget, filter or {})
    end)
    return ok and toNum(moved) or 0
end

-- 5. Selection Menus
local function selectPlayer(managers, promptTitle)
    print("\n=== " .. promptTitle .. " ===")
    for i, m in ipairs(managers) do
        print(string.format(" %d. %s  [Device: %s]", i, m.owner, m.id))
    end
    print("----------------------------------------")
    write("Select player number: ")
    local idx = tonumber(read())
    if idx and managers[idx] then
        return managers[idx]
    end
    print("[ERROR] Invalid selection!")
    return nil
end

local function selectScope()
    print("\n--- Select Scope Category ---")
    print(" 1. All (Entire Inventory + Armor + Offhand)")
    print(" 2. Hotbar only (Slots 0-8)")
    print(" 3. Main Inventory (Slots 9-35)")
    print(" 4. Armor only (Helmet, Chestplate, Leggings, Boots)")
    print(" 5. Offhand only (Left hand slot)")
    print("----------------------------------------")
    write("Choice [1-5]: ")
    local input = read()
    if input == "2" then return "HOTBAR"
    elseif input == "3" then return "MAIN"
    elseif input == "4" then return "ARMOR"
    elseif input == "5" then return "OFFHAND"
    else return "ALL" end
end

local function askFilter()
    write("Filter Item ID (e.g. minecraft:diamond) or ENTER for ALL: ")
    local name = read()
    if not name or name == "" then return {} end
    write("Amount to move (ENTER for maximum): ")
    local cnt = tonumber(read())
    return { name = name, count = cnt }
end

-- 6. Main Interactive Loop
while true do
    local managers = getManagers()
    updateMonitor(managers)

    print("\n========================================")
    print("   MULTI-CONTROLLER INVENTORY SYSTEM")
    print("   Active Cards/Players Connected: " .. #managers)
    print("   Target Chest Side/ID: " .. tostring(chestTarget))
    print("========================================")

    if #managers == 0 then
        print("[WARNING] No bound Memory Cards detected in any Inventory Manager!")
        print("Please insert bound Memory Cards into the managers and press ENTER.")
        read()
    else
        print(" 1. View player inventory contents")
        print(" 2. Export FROM Player TO Chest")
        print(" 3. Import FROM Chest TO Player")
        print(" 4. DIRECT TRANSFER (Player A -> Player B)")
        print(" 5. Exit program")
        print("----------------------------------------")
        write("Select option [1-5]: ")
        local choice = read()

        if choice == "1" then
            local target = selectPlayer(managers, "SELECT PLAYER TO VIEW")
            if target then
                local items = target.obj.getItems() or {}
                print("\n--- Items of " .. target.owner .. " ---")
                local count = 0
                for k, item in pairs(items) do
                    if item and item.count > 0 then
                        print(string.format(" Slot %2d: %-30s x%d", toNum(item.slot or k), item.name, item.count))
                        count = count + 1
                    end
                end
                if count == 0 then print(" Inventory is completely empty.") end
            end

        elseif choice == "2" then
            local target = selectPlayer(managers, "SELECT SENDER (EXPORT FROM)")
            if target then
                local scope = selectScope()
                local filter = askFilter()
                print("\nExporting items from " .. target.owner .. " to chest...")
                local moved = exportFromPlayer(target.obj, filter, scope)
                print(string.format("[SUCCESS] Moved %d items to chest.", moved))
            end

        elseif choice == "3" then
            local target = selectPlayer(managers, "SELECT RECEIVER (IMPORT TO)")
            if target then
                local filter = askFilter()
                print("\nImporting items from chest to " .. target.owner .. "...")
                local moved = importToPlayer(target.obj, filter)
                print(string.format("[SUCCESS] Moved %d items from chest to %s.", moved, target.owner))
            end

        elseif choice == "4" then
            print("\n--- DIRECT TRANSFER SETUP ---")
            local source = selectPlayer(managers, "1. SELECT SENDER (PLAYER A)")
            if source then
                local dest = selectPlayer(managers, "2. SELECT RECEIVER (PLAYER B)")
                if dest and dest.id ~= source.id then
                    local scope = selectScope()
                    local filter = askFilter()
                    
                    print(string.format("\nTransferring from [%s] -> [%s] ...", source.owner, dest.owner))
                    
                    -- Step 1: Pull items from Player A into Chest
                    local pulled = exportFromPlayer(source.obj, filter, scope)
                    if pulled > 0 then
                        -- Step 2: Push items from Chest into Player B
                        local pushed = importToPlayer(dest.obj, filter)
                        print(string.format("[SUCCESS] Transferred %d items directly from %s to %s!", pushed, source.owner, dest.owner))
                    else
                        print("[FAIL] Nothing was pulled from " .. source.owner)
                    end
                else
                    print("[ERROR] Cannot transfer to the same player controller!")
                end
            end

        elseif choice == "5" then
            print("Exiting controller system.")
            break
        end
    end
    sleep(0.5)
end
