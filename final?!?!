local function fetchAllPlayers()
    allServerPlayers = {}
    local added = {}

    if playerDetector then
        local ok, pList = pcall(function()
            if playerDetector.getOnlinePlayers then return playerDetector.getOnlinePlayers() end
            if playerDetector.getPlayers then return playerDetector.getPlayers() end
            if playerDetector.getPlayersInRange then return playerDetector.getPlayersInRange(500) end
            return {}
        end)

        if ok and type(pList) == "table" then
            for _, p in ipairs(pList) do
                local name = type(p) == "table" and (p.name or p.username) or tostring(p)
                if name and name ~= "" and not added[name] then
                    table.insert(allServerPlayers, name)
                    added[name] = true
                end
            end
        end
    end

    if #allServerPlayers == 0 and chatBoxPeripheral and chatBoxPeripheral.getPlayers then
        local ok, pList = pcall(chatBoxPeripheral.getPlayers)
        if ok and type(pList) == "table" then
            for _, p in ipairs(pList) do
                local name = type(p) == "table" and (p.name or p.username) or tostring(p)
                if name and not added[name] then
                    table.insert(allServerPlayers, name)
                    added[name] = true
                end
            end
        end
    end

    for _, mgr in ipairs(managers) do
        if mgr.owner and not added[mgr.owner] then
            table.insert(allServerPlayers, mgr.owner)
            added[mgr.owner] = true
        end
    end

    if #allServerPlayers == 0 then
        table.insert(allServerPlayers, "No Players Found")
    end
end

