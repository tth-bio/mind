    monitor.setTextColor(cTextSec)
    monitor.setCursorPos(2, 4)
    monitor.write("--------------------")

    -- Simulated animated Graphs
    local ticks = os.clock() * 5
    local bar1 = math.floor(math.sin(ticks) * 4 + 5)
    local bar2 = math.floor(math.cos(ticks * 0.8) * 4 + 5)
    
    monitor.setCursorPos(2, 6)
    monitor.setTextColor(cWarn)
