-- ============================================================
--    JARVIS OS :: STRONGHOLD & END PORTAL LOCATOR
--    CC:Tweaked + Advanced Peripherals (Geo Scanner)
-- ============================================================

local geo = peripheral.find("geoScanner") or peripheral.find("geo_scanner")

if not geo then
    error("Error: Geo Scanner not found! Attach a Geo Scanner from Advanced Peripherals.")
end

-- Key Target Blocks for Stronghold / End Portal
local TARGET_BLOCKS = {
    ["minecraft:end_portal_frame"]     = "END PORTAL FRAME",
    ["minecraft:end_portal"]           = "END PORTAL",
    ["minecraft:spawner"]              = "SILVERFISH SPAWNER",
    ["minecraft:stone_bricks"]          = "STONE BRICKS",
    ["minecraft:mossy_stone_bricks"]   = "MOSSY STONE BRICKS",
    ["minecraft:cracked_stone_bricks"] = "CRACKED STONE BRICKS"
}

term.clear()
term.setCursorPos(1, 1)
print("JARVIS OS :: STRONGHOLD LOCATOR")
print("----------------------------------------")

-- Detect Absolute Computer Position via GPS or Manual Input
local compX, compY, compZ = gps.locate(2)

if not compX then
    print("GPS signal not detected!")
    print("Enter Computer Absolute World Position:")
    write("X: ")
    compX = tonumber(read()) or 0
    write("Y: ")
    compY = tonumber(read()) or 0
    write("Z: ")
    compZ = tonumber(read()) or 0
else
    print(string.format("GPS Position: X: %d, Y: %d, Z: %d", compX, compY, compZ))
end

print("----------------------------------------")
print("Scanning surrounding area (Radius: 16)...")

-- Perform Block Scan
local ok, scanResults = pcall(function() return geo.scan(16) end)

if not ok or type(scanResults) ~= "table" then
    print("Error: Failed to scan terrain. Make sure Geo Scanner has power/cooldown.")
    return
end

local foundTargets = {}

for _, block in ipairs(scanResults) do
    if block and block.name and TARGET_BLOCKS[block.name] then
        local absX = compX + block.x
        local absY = compY + block.y
        local absZ = compZ + block.z
        local distance = math.sqrt(block.x^2 + block.y^2 + block.z^2)

        table.insert(foundTargets, {
            type = TARGET_BLOCKS[block.name],
            rawName = block.name,
            x = absX,
            y = absY,
            z = absZ,
            dist = distance
        })
    end
end

print("----------------------------------------")

if #foundTargets == 0 then
    print("No Stronghold structure detected in current radius.")
    print("Move closer to the suspected area and re-run.")
else
    print(string.format("SUCCESS! Found %d Stronghold block(s):\n", #foundTargets))
    for _, item in ipairs(foundTargets) do
        print(string.format("[%s]", item.type))
        print(string.format("  Coordinates : X: %d, Y: %d, Z: %d", item.x, item.y, item.z))
        print(string.format("  Distance    : %.1f blocks\n", item.dist))
    end
end
