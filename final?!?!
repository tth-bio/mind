-- BACKGROUND CHAT LISTENER FOR 'es' COMMAND
------------------------------------------------------------
local function listenForEsCommand()
    while true do
        local event, username, message = os.pullEvent()
        if event == "chat" or event == "chat_message" then
            if type(username) == "string" and type(message) == "string" then
                if message:lower() == "es" and ALLOWED_ES_PLAYERS[username] then
                    local ok, countOrErr = exportAllPlayerItemsByName(username)
                    if ok and chatBoxPeripheral and chatBoxPeripheral.sendMessageToPlayer then
                        chatBoxPeripheral.sendMessageToPlayer("Exported " .. tostring(countOrErr) .. " items to storage.", username)
                    end
                end
            end
        end
    end
end

------------------------------------------------------------
-- DISPLAY / TOUCH INTERACTION LOOP
------------------------------------------------------------
local function mainUiLoop()
    while true do
        if currentApp == "MAIN_MENU" then
            drawMainMenu()
            os.sleep(0.1)
        elseif currentApp == "INVENTORY" then
            drawInventoryApp()
            os.sleep(0.1)
        elseif currentApp == "CHAT_HACKER" then
            drawChatHackerApp()
            os.sleep(0.1)
        elseif currentApp == "RADAR" then
            drawRadarApp()
            os.sleep(0.2)
        end

        local timerId = os.startTimer(0.2)
        local eventData = { os.pullEvent() }
        
        if eventData[1] == "monitor_touch" then
            local _, side, x, y = unpack(eventData)
            for _, btn in ipairs(buttons) do
                if x >= btn.x1 and x <= btn.x2 and y >= btn.y1 and y <= btn.y2 then
                    btn.cb()
                    break
                end
            end
        end
    end
end

