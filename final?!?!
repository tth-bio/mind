    monitor.setCursorPos(2, 7)
    monitor.setTextColor(cActive)
    monitor.write("SCAN [" .. string.rep("|", bar2) .. string.rep(".", 10 - bar2) .. "]")

    -- Radar Frame Dimensions
    local rx1, ry1, rx2, ry2 = 25, 3, mWidth - 2, mHeight - 2
    local cx = math.floor((rx1 + rx2) / 2)
    local cy = math.floor((ry1 + ry2) / 2)
    local radiusX = math.floor((rx2 - rx1) / 2) - 1
    local radiusY = math.floor((ry2 - ry1) / 2) - 1

    -- Render Radar Border & Directions
    monitor.setTextColor(cInactive)
    for x = rx1, rx2 do
        monitor.setCursorPos(x, ry1); monitor.write("-")
        monitor.setCursorPos(x, ry2); monitor.write("-")
    end
    for y = ry1, ry2 do
        monitor.setCursorPos(rx1, y); monitor.write("|")
        monitor.setCursorPos(rx2, y); monitor.write("|")
    end

    monitor.setTextColor(cActive)
    monitor.setCursorPos(cx, ry1 + 1); monitor.write("N")
    monitor.setCursorPos(cx, ry2 - 1); monitor.write("S")
    monitor.setCursorPos(rx1 + 1, cy); monitor.write("W")
    monitor.setCursorPos(rx2 - 1, cy); monitor.write("E")

    -- Center Crosshair
    monitor.setTextColor(cWarn)
    monitor.setCursorPos(cx, cy)
    monitor.write("+")

    -- Query Player Detector Data
    local detectedPlayers = {}
    if playerDetector then
        local ok, pList = pcall(function()
            if playerDetector.getPlayersInRange then return playerDetector.getPlayersInRange(100) end
            if playerDetector.getPlayers then return playerDetector.getPlayers() end
            return {}
        end)

        if ok and type(pList) == "table" then
            for _, p in ipairs(pList) do
                if type(p) == "table" then
                    table.insert(detectedPlayers, {
                        name = p.name or p.username or "Unknown",
                        x = math.floor(p.x or p.relX or 0),
                        y = math.floor(p.y or p.relY or 0),
                        z = math.floor(p.z or p.relZ or 0)
                    })
                end
            end
        end
    end

    -- Render Players on Radar Grid
    monitor.setCursorPos(2, 9)
    monitor.setTextColor(cActive)
    monitor.write("TARGETS IN RANGE: " .. #detectedPlayers)

    local targetListY = 11
    for i, p in ipairs(detectedPlayers) do
        -- Plot on Radar
        local mapX = cx + math.floor((p.x / 50) * radiusX)
        local mapY = cy + math.floor((p.z / 50) * radiusY)

        if mapX >= rx1 + 2 and mapX <= rx2 - 2 and mapY >= ry1 + 2 and mapY <= ry2 - 2 then
            monitor.setCursorPos(mapX, mapY)
            monitor.setTextColor(colors.red)
            monitor.write("O")
        end

        -- Print HUD Target Details on Left Panel
        if targetListY <= mHeight - 2 then
            monitor.setCursorPos(2, targetListY)
            monitor.setTextColor(cSuccess)
            monitor.write("> " .. p.name:sub(1, 14))

            monitor.setCursorPos(2, targetListY + 1)
            monitor.setTextColor(cTextSec)
            monitor.write(string.format("  X:%d Y:%d Z:%d", p.x, p.y, p.z))

            targetListY = targetListY + 3
        end
    end
end

