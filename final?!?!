------------------------------------------------------------
local function sendRobustToast(message, title, targetPlayer)
    if not chatBoxPeripheral then return false, "ChatBox not connected" end
    
    title = title or "JARVIS SYSTEM"
    local jsonMsg = string.format('{"text":"%s"}', message)
    local jsonTitle = string.format('{"text":"%s"}', title)
    
    -- Try Option 1: Standard sendToast (Text, Title, Player)
    local ok = pcall(function() chatBoxPeripheral.sendToast(message, title, targetPlayer) end)
    if ok then return true, "Toast sent (Standard)" end

    -- Try Option 2: Transposed Arguments (Player, Title, Text)
    ok = pcall(function() chatBoxPeripheral.sendToast(targetPlayer, title, message) end)
    if ok then return true, "Toast sent (Format B)" end

    -- Try Option 3: JSON Formatted Toast
    ok = pcall(function() chatBoxPeripheral.sendToast(jsonMsg, jsonTitle, targetPlayer) end)
    if ok then return true, "Toast sent (JSON)" end

    -- Fallback Option 4: Direct System Message to Player Chat if Toast fails on Client
    ok = pcall(function() 
        chatBoxPeripheral.sendMessageToPlayer("[" .. title .. "] " .. message, targetPlayer, "JARVIS") 
    end)
    if ok then return true, "Sent as Direct Message (Toast Fallback)" end

    return false, "Failed to deliver message"
end

