-- ============================================================
--  Inventory Manager Controller
--  CC:Tweaked + Advanced Peripherals
--  Chest above computer + optional Monitor
-- ============================================================

-- ------------------------------------------------------------
-- 1. Peripherals
-- ------------------------------------------------------------
local manager = peripheral.find("inventory_manager")
if not manager then
    error("Inventory Manager not found. Connect the block to the computer.")
end

local monitor = peripheral.find("monitor")  -- may be nil
if monitor then
    monitor.setTextScale(0.5)
    monitor.clear()
end

-- Auto-detect storage block
local function findStorage()
    for _, name in ipairs(peripheral.getNames()) do
        local t = peripheral.getType(name)
        if t == "minecraft:chest"
        or t == "minecraft:barrel"
        or t == "minecraft:trapped_chest"
        or t == "minecraft:shulker_box"
        or t == "ironchest:iron_chest"
        or t == "ironchest:gold_chest"
        or t == "ironchest:diamond_chest"
        or t == "ironchest:crystal_chest"
        or t == "ironchest:obsidian_chest" then
            return name
        end
    end
    return nil
end

local chest = findStorage()
if not chest then
    error("No storage block found nearby. Place a chest next to the computer.")
end

-- ------------------------------------------------------------
-- 2. Owner check
-- ------------------------------------------------------------
local ownerUuid, ownerName = manager.getOwner()
if not ownerUuid then
    error("Memory card not inserted or owner offline.\n" ..
          "Insert a bound Memory Card into the Inventory Manager.")
end

-- ------------------------------------------------------------
-- 3. Monitor helper
-- ------------------------------------------------------------
--- Redraw the whole inventory on the monitor (if present)
local function updateMonitor()
    if not monitor then return end

    monitor.clear()
    monitor.setCursorPos(1, 1)
    monitor.setTextColour(colors.yellow)
    monitor.write("=== Inventory ===")
    monitor.setTextColour(colors.white)

    local line = 3
    local ok, items = pcall(function() return manager.list() end)

    if not ok or not items or not next(items) then
        monitor.setCursorPos(1, line)
        monitor.write("(empty or list() unavailable)")
        return
    end

    -- Collect and sort by slot for stable output
    local sorted = {}
    for slot, item in pairs(items) do
        table.insert(sorted, { slot = slot, item = item })
    end
    table.sort(sorted, function(a, b) return a.slot < b.slot end)

    for _, entry in ipairs(sorted) do
        if line > 20 then  -- don't overflow a small monitor
            monitor.setCursorPos(1, 21)
            monitor.write("... (truncated)")
            break
        end

        local item = entry.item
        local name = "unknown"
        local count = 0
        local dname = ""

        if type(item) == "table" then
            name  = tostring(item.name or "?")
            count = tonumber(item.count) or 0
            dname = tostring(item.displayName or name)
        else
            name = tostring(item)
        end

        -- Trim long registry names so they fit
        if #name > 22 then name = name:sub(1, 21) .. "…" end
        if #dname > 22 then dname = dname:sub(1, 21) .. "…" end

        monitor.setCursorPos(1, line)
        monitor.write(string.format("%3d %-22s x%-4d", entry.slot, name, count))

        line = line + 1
        monitor.setCursorPos(1, line)
        monitor.setTextColour(colors.lightGrey)
        monitor.write("    " .. dname)
        monitor.setTextColour(colors.white)
        line = line + 1
    end
end

-- ------------------------------------------------------------
-- 4. Helper functions
-- ------------------------------------------------------------

--- Print inventory to the computer terminal
local function listInventory()
    local ok, items = pcall(function() return manager.list() end)
    if not ok or not items or not next(items) then
        print("Inventory is empty (or 'list' unavailable).")
        return
    end

    print("--- Inventory contents ---")
    for slot, item in pairs(items) do
        if type(item) == "table" then
            print(string.format("  Slot %3s: %-40s x%-4s  (%s)",
                tostring(slot),
                tostring(item.name or "?"),
                tostring(item.count or 0),
                tostring(item.displayName or item.name or "?")
            ))
        else
            print(string.format("  Slot %3s: %s", tostring(slot), tostring(item)))
        end
    end
    print("--------------------------")
end

--- Export items from player inventory to chest
-- @param filter  table filter or nil
local function exportToChest(filter)
    local ok, moved = pcall(function()
        return manager.exportItem(chest, filter or {})
    end)

    if not ok then
        print("[FAIL] exportItem error: " .. tostring(moved))
        return 0
    end

    moved = tonumber(moved) or 0
    if moved > 0 then
        print(string.format("[OK] Exported %d items to %s", moved, tostring(chest)))
    else
        print("[FAIL] Nothing exported (no matching items or chest full).")
    end
    updateMonitor()
    return moved
end

--- Import items from chest into player inventory
-- @param filter  table filter or nil
local function importFromChest(filter)
    local ok, moved = pcall(function()
        return manager.importItem(chest, filter or {})
    end)

    if not ok then
        print("[FAIL] importItem error: " .. tostring(moved))
        return 0
    end

    moved = tonumber(moved) or 0
    if moved > 0 then
        print(string.format("[OK] Imported %d items from %s", moved, tostring(chest)))
    else
        print("[FAIL] Nothing imported (no matching items or inventory full).")
    end
    updateMonitor()
    return moved
end

--- Export everything from inventory to chest
local function exportAll()
    return exportToChest(nil)
end

--- Import everything from chest into inventory
local function importAll()
    return importFromChest(nil)
end

-- ------------------------------------------------------------
-- 5. Menu
-- ------------------------------------------------------------
local function showMenu()
    print()
    print("========== MENU ==========")
    print(" 1. Show inventory (terminal + monitor)")
    print(" 2. Export ALL to chest")
    print(" 3. Import ALL from chest")
    print(" 4. Export by filter")
    print(" 5. Import by filter")
    print(" 6. Exit")
    print("==========================")
    write("Choose an option: ")
end

--- Ask the user for a filter.
-- NOTE: In recent Advanced Peripherals slot indices in filters
-- are 0-based (0..35), unlike Lua's usual 1-based indexing.
local function askFilter()
    write("Item name (e.g. minecraft:cobblestone) or blank to cancel: ")
    local name = read()
    if not name or name == "" then return nil end

    write("Amount (Enter = default): ")
    local cntStr = read()
    local filter = { name = name }

    if cntStr and cntStr ~= "" then
        local cnt = tonumber(cntStr)
        if cnt then filter.count = cnt end
    end

    return filter
end

-- ------------------------------------------------------------
-- 6. Initial draw + main loop
-- ------------------------------------------------------------
updateMonitor()
print(string.format("Player: %s (%s)", tostring(ownerName), tostring(ownerUuid)))
print(string.format("Chest:  %s", tostring(chest)))
if monitor then
    print("Monitor: connected")
else
    print("Monitor: not found (optional)")
end

while true do
    showMenu()
    local choice = read()

    if choice == "1" then
        listInventory()
        updateMonitor()

    elseif choice == "2" then
        exportAll()

    elseif choice == "3" then
        importAll()

    elseif choice == "4" then
        local f = askFilter()
        if f then exportToChest(f) end

    elseif choice == "5" then
        local f = askFilter()
        if f then importFromChest(f) end

    elseif choice == "6" then
        print("Exiting.")
        break

    else
        print("Invalid choice. Try again.")
    end

    sleep(0.3)
end
