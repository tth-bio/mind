-- ============================================================
--   TOUCHSCREEN 4-PLAYER INVENTORY CONTROLLER
--   CC:Tweaked + Advanced Peripherals (Support 4+ Players)
-- ============================================================

local monitor = peripheral.find("monitor")
if not monitor then
    error("Touchscreen Monitor not found! Attach a monitor to the computer.")
end

monitor.setTextScale(0.5)
local mWidth, mHeight = monitor.getSize()

-- Colors Palette
local cBg        = colors.black
local cHeader    = colors.blue
local cText      = colors.white
local cAccent    = colors.cyan
local cBtnActive = colors.lime
local cBtnBg     = colors.gray
local cWarn      = colors.yellow
local cFail      = colors.red
local cSub       = colors.lightGray
local cSuccess   = colors.green
local cSrcColor  = colors.blue
local cDstColor  = colors.purple

-- State Variables
local managers = {}
local connectedStorages = {}
local selectedSourceIdx = 1
local selectedTargetIdx = 2

local currentTab = "EXPORT" -- "EXPORT", "IMPORT", "TRANSFER"
local currentScope = "ALL"  -- "ALL", "HOTBAR", "MAIN", "ARMOR", "OFFHAND"
local selectedAmountMode = "ALL" -- "1", "STACK", "ALL"
local currentPage = 1
local itemsPerPage = 7
local cachedItemList = {}
local buttons = {}

local SCAN_DIRECTIONS = { "up", "down", "north", "south", "east", "west", "top", "bottom" }

-- Detect relative direction to chest
local function detectChestDirection(mgrObj)
    for _, dir in ipairs(SCAN_DIRECTIONS) do
        local ok, size = pcall(function() return mgrObj.getContainerSize(dir) end)
        if ok and type(size) == "number" and size > 0 then
            return dir
        end
    end
    return "up"
end

-- 1. Hardware Scanner
local function scanPeripherals()
    managers = {}
    connectedStorages = {}
    local names = peripheral.getNames()

    for _, name in ipairs(names) do
        local pType = peripheral.getType(name) or ""

        -- Detect Inventory Managers
        if pType == "inventory_manager" or pType == "inventoryManager" then
            local obj = peripheral.wrap(name)
            local owner = nil
            pcall(function() if obj.getOwner then owner = obj.getOwner() end end)
            
            if owner and owner ~= "" then
                local dir = detectChestDirection(obj)
                table.insert(managers, {
                    id = name,
                    obj = obj,
                    owner = owner,
                    chestDir = dir
                })
            end

        -- Detect Networked Storages (Chests/Barrels)
        elseif string.find(pType, "chest") or string.find(pType, "barrel") or string.find(pType, "shulker") or string.find(pType, "storage") then
            local obj = peripheral.wrap(name)
            if obj then
                table.insert(connectedStorages, { id = name, obj = obj })
            end
        end
    end

    -- Keep target index valid if player count changed
    if #managers > 0 then
        if selectedSourceIdx > #managers then selectedSourceIdx = 1 end
        if selectedTargetIdx > #managers then selectedTargetIdx = math.min(2, #managers) end
    end
end

scanPeripherals()

-- Helper function to parse slot scope
local function toNum(v) return tonumber(v) or 0 end

local function isSlotInScope(slotNum, scope)
    if scope == "ALL" then return true
    elseif scope == "HOTBAR" then return slotNum >= 0 and slotNum <= 8
    elseif scope == "MAIN" then return slotNum >= 9 and slotNum <= 35
    elseif scope == "ARMOR" then return (slotNum >= 100 and slotNum <= 103) or (slotNum >= 36 and slotNum <= 39)
    elseif scope == "OFFHAND" then return slotNum == 36 or slotNum == 104 end
    return true
end

-- 2. Operations Logic
local function exportPlayerToChest(mgr, slotNum, count, itemName)
    local dir = mgr.chestDir or "up"
    
    local ok, res = pcall(function()
        return mgr.obj.removeItemFromPlayer(dir, { fromSlot = slotNum, count = count })
    end)
    if ok and type(res) == "number" and res > 0 then return res end

    ok, res = pcall(function()
        return mgr.obj.removeItemFromPlayer(dir, count, slotNum)
    end)
    if ok and type(res) == "number" and res > 0 then return res end

    if itemName and itemName ~= "" then
        ok, res = pcall(function()
            return mgr.obj.removeItemFromPlayer(dir, { name = itemName, count = count })
        end)
        if ok and type(res) == "number" and res > 0 then return res end
    end

    return 0
end

local function importChestToPlayer(mgr, chestSlotNum, count, itemName)
    local dir = mgr.chestDir or "up"

    if itemName and itemName ~= "" then
        local ok, res = pcall(function()
            return mgr.obj.addItemToPlayer(dir, { name = itemName, count = count })
        end)
        if ok and type(res) == "number" and res > 0 then return res end
    end

    if chestSlotNum then
        local ok, res = pcall(function()
            return mgr.obj.addItemToPlayer(dir, { fromSlot = chestSlotNum, count = count })
        end)
        if ok and type(res) == "number" and res > 0 then return res end
    end

    local ok, res = pcall(function()
        return mgr.obj.addItemToPlayer(dir, count)
    end)
    if ok and type(res) == "number" and res > 0 then return res end

    return 0
end

-- 3. Items Scanner
local function refreshItems()
    cachedItemList = {}
    if #managers == 0 then return end

    if currentTab == "EXPORT" or currentTab == "TRANSFER" then
        local mgr = managers[selectedSourceIdx]
        if not mgr then return end

        local ok, res = pcall(function() return mgr.obj.getItems() end)
        if ok and type(res) == "table" then
            for slotKey, item in pairs(res) do
                if type(item) == "table" and item.count and item.count > 0 then
                    local sNum = toNum(item.slot or item.slotNumber or slotKey)
                    if isSlotInScope(sNum, currentScope) then
                        table.insert(cachedItemList, {
                            slot = sNum,
                            name = item.name,
                            displayName = item.displayName or item.name,
                            count = item.count
                        })
                    end
                end
            end
        end

    elseif currentTab == "IMPORT" then
        for _, st in ipairs(connectedStorages) do
            local list = nil
            pcall(function()
                if st.obj.list then list = st.obj.list()
                elseif st.obj.getItems then list = st.obj.getItems() end
            end)

            if type(list) == "table" then
                for slot, item in pairs(list) do
                    if item and item.count and item.count > 0 then
                        local dName = item.displayName or item.name
                        if not dName and st.obj.getItemDetail then
                            pcall(function()
                                local detail = st.obj.getItemDetail(slot)
                                if detail then dName = detail.displayName or detail.name end
                            end)
                        end

                        table.insert(cachedItemList, {
                            slot = slot,
                            name = item.name or "unknown",
                            displayName = dName or item.name or "Unknown Item",
                            count = item.count
                        })
                    end
                end
            end
        end
    end
end

-- 4. GUI Rendering Engine
local function clearButtons() buttons = {} end

local function addBtn(x1, y1, x2, y2, label, bg, fg, callback)
    table.insert(buttons, { x1 = x1, y1 = y1, x2 = x2, y2 = y2, cb = callback })
    monitor.setBackgroundColor(bg)
    monitor.setTextColor(fg)
    for y = y1, y2 do
        monitor.setCursorPos(x1, y)
        monitor.write(string.rep(" ", x2 - x1 + 1))
    end
    local lx = math.floor(x1 + (x2 - x1 + 1 - #label) / 2)
    local ly = math.floor(y1 + (y2 - y1) / 2)
    monitor.setCursorPos(lx, ly)
    monitor.write(label)
end

local function drawGUI(statusMessage, statusColor)
    clearButtons()
    monitor.setBackgroundColor(cBg)
    monitor.clear()

    -- Title Bar
    monitor.setBackgroundColor(cHeader)
    monitor.setTextColor(colors.white)
    monitor.setCursorPos(1, 1)
    monitor.clearLine()
    monitor.write(" MULTI-PLAYER INVENTORY CONTROLLER (4 PLAYERS) ")

    -- Mode Tabs
    local t1Color = (currentTab == "EXPORT") and cBtnActive or cBtnBg
    local t2Color = (currentTab == "IMPORT") and cBtnActive or cBtnBg
    local t3Color = (currentTab == "TRANSFER") and cBtnActive or cBtnBg

    addBtn(1, 3, 14, 4, "EXPORT", t1Color, colors.black, function()
        currentTab = "EXPORT"
        currentPage = 1
        refreshItems()
    end)

    addBtn(16, 3, 29, 4, "IMPORT", t2Color, colors.black, function()
        currentTab = "IMPORT"
        currentPage = 1
        refreshItems()
    end)

    addBtn(31, 3, 45, 4, "TRANSFER", t3Color, colors.black, function()
        currentTab = "TRANSFER"
        currentPage = 1
        refreshItems()
    end)

    -- Status Notification Line
    if statusMessage then
        monitor.setCursorPos(1, 6)
        monitor.setBackgroundColor(cBg)
        monitor.setTextColor(statusColor or cAccent)
        monitor.write("Status: " .. statusMessage)
    end

    if #managers == 0 then
        monitor.setCursorPos(1, 8)
        monitor.setTextColor(cFail)
        monitor.write("No Inventory Managers Found!")
        return
    end

    -- 4 PLAYERS SELECTOR BAR
    monitor.setCursorPos(1, 8)
    monitor.setTextColor(cSub)
    if currentTab == "TRANSFER" then
        monitor.write("Src(Blue)/Dst(Purp):")
    else
        monitor.write("Active Player:")
    end

    local btnWidth = 10
    local startX = 1
    for idx, mgr in ipairs(managers) do
        if idx <= 4 then -- Display top 4 players
            local pName = mgr.owner:sub(1, 8)
            local btnBg = cBtnBg
            local btnFg = colors.white

            if currentTab == "TRANSFER" then
                if idx == selectedSourceIdx then btnBg = cSrcColor
                elseif idx == selectedTargetIdx then btnBg = cDstColor end
            else
                if idx == selectedSourceIdx then btnBg = cBtnActive; btnFg = colors.black end
            end

            local yPos = 9
            local x1 = startX + (idx - 1) * 12
            local x2 = x1 + 10

            addBtn(x1, yPos, x2, yPos + 1, pName, btnBg, btnFg, function()
                if currentTab == "TRANSFER" then
                    if selectedSourceIdx ~= idx then
                        selectedSourceIdx = idx
                    else
                        -- Toggle as target if clicked again
                        selectedTargetIdx = idx
                    end
                else
                    selectedSourceIdx = idx
                end
                refreshItems()
            end)
        end
    end

    -- Scope Selector Row
    if currentTab == "EXPORT" or currentTab == "TRANSFER" then
        monitor.setCursorPos(1, 12)
        monitor.setTextColor(cSub)
        monitor.write("Scope:")
        
        local scopes = { "ALL", "HOTBAR", "MAIN", "ARMOR", "OFFHAND" }
        local sX = 8
        for _, sc in ipairs(scopes) do
            local scBg = (currentScope == sc) and cBtnActive or cBtnBg
            addBtn(sX, 12, sX + #sc + 1, 12, sc, scBg, colors.black, function()
                currentScope = sc
                currentPage = 1
                refreshItems()
            end)
            sX = sX + #sc + 2
        end
    end

    -- Amount Selector Row
    monitor.setCursorPos(1, 14)
    monitor.setTextColor(cSub)
    monitor.write("Amount:")
    local amounts = { { id = "1", label = "x1" }, { id = "STACK", label = "x64" }, { id = "ALL", label = "MAX" } }
    local aX = 9
    for _, am in ipairs(amounts) do
        local aBg = (selectedAmountMode == am.id) and cBtnActive or cBtnBg
        addBtn(aX, 14, aX + #am.label + 1, 14, am.label, aBg, colors.black, function()
            selectedAmountMode = am.id
        end)
        aX = aX + #am.label + 3
    end

    -- Items Header
    monitor.setCursorPos(1, 16)
    monitor.setTextColor(cWarn)
    monitor.write("--- CLICK ITEM BELOW TO PROCESS ---")

    -- List Items
    local totalPages = math.max(1, math.ceil(#cachedItemList / itemsPerPage))
    if currentPage > totalPages then currentPage = totalPages end

    local startIndex = (currentPage - 1) * itemsPerPage + 1
    local endIndex = math.min(#cachedItemList, startIndex + itemsPerPage - 1)

    local startY = 18
    if #cachedItemList == 0 then
        monitor.setCursorPos(3, startY)
        monitor.setTextColor(cFail)
        if currentTab == "IMPORT" and #connectedStorages == 0 then
            monitor.write("(No chest connected via active modem!)")
        else
            monitor.write("(No items found)")
        end
    else
        for i = startIndex, endIndex do
            local item = cachedItemList[i]
            local nameStr = tostring(item.displayName or item.name)
            if #nameStr > 28 then nameStr = nameStr:sub(1, 25) .. "..." end
            local label = string.format("Slot %-2d | %-28s x%d", item.slot, nameStr, item.count)

            addBtn(1, startY, mWidth - 2, startY, label, colors.gray, colors.white, function()
                local srcMgr = managers[selectedSourceIdx]
                local dstMgr = managers[selectedTargetIdx]

                local moveCount = item.count
                if selectedAmountMode == "1" then moveCount = 1
                elseif selectedAmountMode == "STACK" then moveCount = math.min(64, item.count) end

                if currentTab == "EXPORT" then
                    local moved = exportPlayerToChest(srcMgr, item.slot, moveCount, item.name)
                    if moved > 0 then
                        drawGUI(string.format("Exported %d x %s from %s", moved, nameStr, srcMgr.owner), cSuccess)
                    else
                        drawGUI("Export failed! Player too far or chest full.", cFail)
                    end

                elseif currentTab == "IMPORT" then
                    local moved = importChestToPlayer(srcMgr, item.slot, moveCount, item.name)
                    if moved > 0 then
                        drawGUI(string.format("Imported %d x %s to %s", moved, nameStr, srcMgr.owner), cSuccess)
                    else
                        drawGUI("Import failed! Player too far or inventory full.", cFail)
                    end

                elseif currentTab == "TRANSFER" then
                    if srcMgr and dstMgr then
                        if selectedSourceIdx == selectedTargetIdx then
                            drawGUI("Select TWO DIFFERENT players for Transfer!", cFail)
                        else
                            local pulled = exportPlayerToChest(srcMgr, item.slot, moveCount, item.name)
                            if pulled > 0 then
                                local pushed = importChestToPlayer(dstMgr, nil, pulled, item.name)
                                if pushed > 0 then
                                    drawGUI(string.format("Moved %d x %s (%s -> %s)", pushed, nameStr, srcMgr.owner, dstMgr.owner), cSuccess)
                                else
                                    drawGUI(string.format("In chest, but transfer to %s failed!", dstMgr.owner), cWarn)
                                end
                            else
                                drawGUI("Transfer failed! Could not pull item.", cFail)
                            end
                        end
                    end
                end
                refreshItems()
            end)
            startY = startY + 1
        end
    end

    -- Pagination & Refresh
    addBtn(1, mHeight - 1, 10, mHeight - 1, "< PREV", cHeader, colors.white, function()
        if currentPage > 1 then
            currentPage = currentPage - 1
            drawGUI()
        end
    end)

    monitor.setCursorPos(12, mHeight - 1)
    monitor.setTextColor(colors.white)
    monitor.write(string.format("Page %d/%d", currentPage, totalPages))

    addBtn(22, mHeight - 1, 31, mHeight - 1, "NEXT >", cHeader, colors.white, function()
        if currentPage < totalPages then
            currentPage = currentPage + 1
            drawGUI()
        end
    end)

    addBtn(33, mHeight - 1, mWidth - 1, mHeight - 1, "REFRESH", cWarn, colors.black, function()
        scanPeripherals()
        refreshItems()
        drawGUI("Scanned all 4 managers & storages.", cAccent)
    end)
end

-- 5. Main Execution Loop
refreshItems()
drawGUI("System initialized.", cSuccess)

while true do
    local event, side, x, y = os.pullEvent("monitor_touch")
    
    for _, btn in ipairs(buttons) do
        if x >= btn.x1 and x <= btn.x2 and y >= btn.y1 and y <= btn.y2 then
            btn.cb()
            drawGUI()
            break
        end
    end
end
