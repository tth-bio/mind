-- Configuration
local CHEST_SIDE = "top" -- Direction of chest relative to Inventory Manager ("top", "bottom", "north", "south", etc.)

-- Peripherals
local manager = peripheral.find("inventoryManager")
local monitor = peripheral.find("monitor")

if not manager then
    error("Error: Inventory Manager not found!")
end

if not monitor then
    error("Error: Monitor not found! Please attach a monitor.")
end

-- Monitor Setup
monitor.setTextScale(0.5)
monitor.setBackgroundColor(colors.black)
monitor.clear()

local w, h = monitor.getSize()

-- Global state
local playerItems = {}
local selectedIndex = 1
local scrollOffset = 0
local visibleRows = h - 6

-- Utility: Truncate strings to fit UI
local function fitString(str, len)
    if #str > len then
        return str:sub(1, len - 3) .. "..."
    end
    return str .. string.rep(" ", len - #str)
end

-- Fetch Items from Player Inventory
local function refreshPlayerItems()
    playerItems = {}
    local rawItems = manager.getItems() or {}
    
    -- Consolidate items or keep per-slot
    for _, item in pairs(rawItems) do
        if item and item.count > 0 then
            table.insert(playerItems, {
                slot = item.slot or item.slotNumber,
                name = item.name,
                displayName = item.displayName or item.name:match(":(.+)"):gsub("_", " "):gsub("^%l", string.upper),
                count = item.count
            })
        end
    end

    if selectedIndex > #playerItems then
        selectedIndex = math.max(1, #playerItems)
    end
end

-- Render GUI
local function drawGUI()
    monitor.setBackgroundColor(colors.black)
    monitor.clear()

    -- Title Bar
    local owner = manager.getOwner and manager.getOwner() or "Unknown Player"
    monitor.setCursorPos(1, 1)
    monitor.setBackgroundColor(colors.gray)
    monitor.setTextColor(colors.white)
    monitor.clearLine()
    monitor.write(fitString(" PLAYER: " .. owner, w))

    -- Header Line
    monitor.setCursorPos(1, 2)
    monitor.setBackgroundColor(colors.blue)
    monitor.setTextColor(colors.white)
    monitor.clearLine()
    monitor.write(fitString(" Slot | Item Name                      | Count", w))

    -- Item List
    for i = 1, visibleRows do
        local itemIdx = i + scrollOffset
        local lineY = i + 2
        monitor.setCursorPos(1, lineY)

        if itemIdx <= #playerItems then
            local item = playerItems[itemIdx]
            
            if itemIdx == selectedIndex then
                monitor.setBackgroundColor(colors.cyan)
                monitor.setTextColor(colors.black)
            else
                monitor.setBackgroundColor(colors.black)
                monitor.setTextColor(colors.white)
            end

            monitor.clearLine()
            local lineText = string.format(" %-4d | %-30s | x%-5d", item.slot or itemIdx, fitString(item.displayName, 30), item.count)
            monitor.write(fitString(lineText, w))
        else
            monitor.setBackgroundColor(colors.black)
            monitor.clearLine()
        end
    end

    -- Controls / Buttons
    local startY = h - 2

    -- Row 1: ALL Actions
    monitor.setCursorPos(1, startY)
    monitor.setBackgroundColor(colors.green)
    monitor.setTextColor(colors.black)
    monitor.write("[ EXPORT ALL ]")
    
    monitor.setCursorPos(17, startY)
    monitor.setBackgroundColor(colors.orange)
    monitor.setTextColor(colors.black)
    monitor.write("[ IMPORT ALL ]")

    monitor.setCursorPos(33, startY)
    monitor.setBackgroundColor(colors.lightGray)
    monitor.setTextColor(colors.black)
    monitor.write("[ REFRESH ]")

    -- Row 2: SELECTED Item Actions
    monitor.setCursorPos(1, startY + 1)
    monitor.setBackgroundColor(colors.lime)
    monitor.setTextColor(colors.black)
    monitor.write("[ EXPORT SELECTED ]")

    monitor.setCursorPos(21, startY + 1)
    monitor.setBackgroundColor(colors.yellow)
    monitor.setTextColor(colors.black)
    monitor.write("[ IMPORT SELECTED ]")
end

-- Transfer Logic
local function exportSelected()
    if #playerItems == 0 or not playerItems[selectedIndex] then return end
    local item = playerItems[selectedIndex]
    
    -- Move item from player to chest
    pcall(function()
        manager.removeItemFromPlayer(CHEST_SIDE, {
            name = item.name,
            count = item.count
        })
    end)
    refreshPlayerItems()
end

local function exportAll()
    pcall(function()
        manager.removeItemFromPlayer(CHEST_SIDE, {})
    end)
    refreshPlayerItems()
end

local function importSelected()
    if #playerItems == 0 or not playerItems[selectedIndex] then return end
    local item = playerItems[selectedIndex]

    -- Move item from chest to player
    pcall(function()
        manager.addItemToPlayer(CHEST_SIDE, {
            name = item.name,
            count = item.count
        })
    end)
    refreshPlayerItems()
end

local function importAll()
    pcall(function()
        manager.addItemToPlayer(CHEST_SIDE, {})
    end)
    refreshPlayerItems()
end

-- Event Loop
refreshPlayerItems()
drawGUI()

while true do
    local event, side, x, y = os.pullEvent()

    if event == "monitor_touch" then
        local startY = h - 2

        -- Clicked on Item Row
        if y >= 3 and y < 3 + visibleRows then
            local clickedIdx = y - 2 + scrollOffset
            if clickedIdx <= #playerItems then
                selectedIndex = clickedIdx
            end
        
        -- Clicked EXPORT ALL
        elseif y == startY and x >= 1 and x <= 14 then
            exportAll()

        -- Clicked IMPORT ALL
        elseif y == startY and x >= 17 and x <= 30 then
            importAll()

        -- Clicked REFRESH
        elseif y == startY and x >= 33 and x <= 43 then
            refreshPlayerItems()

        -- Clicked EXPORT SELECTED
        elseif y == startY + 1 and x >= 1 and x <= 18 then
            exportSelected()

        -- Clicked IMPORT SELECTED
        elseif y == startY + 1 and x >= 21 and x <= 38 then
            importSelected()
        end

        drawGUI()

    elseif event == "mouse_scroll" then
        local direction = side -- In mouse_scroll, 2nd param is direction (-1 = up, 1 = down)
        if direction < 0 then
            scrollOffset = math.max(0, scrollOffset - 1)
        elseif direction > 0 then
            scrollOffset = math.min(math.max(0, #playerItems - visibleRows), scrollOffset + 1)
        end
        drawGUI()
    end
end
