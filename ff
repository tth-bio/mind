-- ============================================================
--  Player Coordinates Display
--  CC:Tweaked + Advanced Peripherals (Player Detector)
--  Выводит имена и координаты игроков на монитор
-- ============================================================

-- ------------------------------------------------------------
-- 1. Поиск периферии
-- ------------------------------------------------------------
local detector = peripheral.find("playerDetector")
if not detector then
    error("Player Detector не найден. Подключите блок к компьютеру.")
end

local monitor = peripheral.find("monitor")
if not monitor then
    error("Монитор не найден. Подключите монитор к компьютеру.")
end

-- Мелкий шрифт, чтобы влезло больше строк
pcall(function()
    monitor.setTextScale(0.5)
end)

-- ------------------------------------------------------------
-- 2. Настройки
-- ------------------------------------------------------------
local RANGE = 100          -- радиус поиска игроков (в блоках)
local UPDATE_INTERVAL = 1  -- обновление раз в секунду
local SHOW_DIMENSION = true -- показывать ли измерение игрока

-- ------------------------------------------------------------
-- 3. Вспомогательные функции
-- ------------------------------------------------------------

--- Безопасное получение числа
local function toNum(v)
    return tonumber(v) or 0
end

--- Обрезка длинных строк
local function shortStr(s, maxLen)
    s = tostring(s or "?")
    maxLen = maxLen or 16
    if #s > maxLen then
        s = s:sub(1, maxLen - 3) .. "..."
    end
    return s
end

--- Получить список игроков в радиусе
local function getPlayers()
    local ok, players = pcall(function()
        return detector.getPlayersInRange(RANGE)
    end)

    if not ok or type(players) ~= "table" then
        -- Fallback: попробовать getOnlinePlayers, если getPlayersInRange недоступен
        ok, players = pcall(function()
            return detector.getOnlinePlayers()
        end)
    end

    if not ok or type(players) ~= "table" then
        return {}
    end
    return players
end

--- Получить координаты конкретного игрока
local function getPlayerPos(username)
    local ok, data = pcall(function()
        return detector.getPlayerPos(username)
    end)

    if not ok or type(data) ~= "table" then
        return nil
    end

    return {
        x = toNum(data.x),
        y = toNum(data.y),
        z = toNum(data.z),
        dimension = tostring(data.dimension or "?"),
    }
end

-- ------------------------------------------------------------
-- 4. Отрисовка на мониторе
-- ------------------------------------------------------------
local function render()
    local players = getPlayers()

    -- Очистка экрана
    pcall(function()
        monitor.setBackgroundColour(colors.black)
        monitor.setTextColour(colors.white)
        monitor.clear()
    end)

    -- Заголовок
    monitor.setCursorPos(1, 1)
    monitor.setTextColour(colors.yellow)
    monitor.write("=== Player Coordinates ===")

    monitor.setCursorPos(1, 2)
    monitor.setTextColour(colors.lightGrey)
    monitor.write(string.format("Range: %d blocks", RANGE))

    -- Если игроков нет
    if #players == 0 then
        monitor.setCursorPos(1, 4)
        monitor.setTextColour(colors.red)
        monitor.write("No players in range.")
        return
    end

    -- Строка заголовков таблицы
    local line = 4
    monitor.setCursorPos(1, line)
    monitor.setTextColour(colors.cyan)
    monitor.write(string.format("%-16s %6s %6s %6s", "Player", "X", "Y", "Z"))
    line = line + 1

    -- Строка-разделитель
    monitor.setCursorPos(1, line)
    monitor.setTextColour(colors.grey)
    monitor.write(string.rep("-", 38))
    line = line + 1

    -- Данные по каждому игроку
    for _, username in ipairs(players) do
        -- Получаем координаты
        local pos = getPlayerPos(username)

        monitor.setCursorPos(1, line)
        monitor.setTextColour(colors.white)

        if pos then
            monitor.write(string.format(
                "%-16s %6d %6d %6d",
                shortStr(username, 16),
                pos.x, pos.y, pos.z
            ))
        else
            monitor.setTextColour(colors.red)
            monitor.write(string.format("%-16s %s", shortStr(username, 16), "N/A"))
        end

        line = line + 1

        -- Дополнительная строка с измерением
        if SHOW_DIMENSION and pos then
            monitor.setCursorPos(1, line)
            monitor.setTextColour(colors.lightGrey)
            monitor.write("  -> " .. shortStr(pos.dimension, 34))
            line = line + 1
        end

        -- Защита от переполнения экрана
        if line > 18 then
            monitor.setCursorPos(1, line)
            monitor.setTextColour(colors.yellow)
            monitor.write("... (more players)")
            break
        end
    end

    -- Футер
    monitor.setCursorPos(1, 20)
    monitor.setTextColour(colors.grey)
    monitor.write("Updated: " .. os.date("%H:%M:%S"))
end

-- ------------------------------------------------------------
-- 5. Основной цикл
-- ------------------------------------------------------------
print("Player Coordinates Display запущен.")
print(string.format("Радиус: %d блоков | Обновление: %d сек", RANGE, UPDATE_INTERVAL))
print("Для остановки нажмите Ctrl+T")

while true do
    local ok, err = pcall(render)
    if not ok then
        print("[WARN] Ошибка отрисовки: " .. tostring(err))
    end
    sleep(UPDATE_INTERVAL)
end
