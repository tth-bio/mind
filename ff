-- ============================================================
--  Player Coordinates Display
--  CC:Tweaked + Advanced Peripherals (Player Detector)
--  Auto-detects player_detector / playerDetector
-- ============================================================

-- ------------------------------------------------------------
-- 1. Peripheral detection
-- ------------------------------------------------------------
local function findPlayerDetector()
    -- First: by exact peripheral name
    local candidates = { "playerDetector", "player_detector" }
    for _, n in ipairs(candidates) do
        local ok, p = pcall(peripheral.find, n)
        if ok and p then return p, n end
    end

    -- Second: scan all peripherals by type
    for _, name in ipairs(peripheral.getNames()) do
        local t = peripheral.getType(name)
        if t == "playerDetector"
        or t == "player_detector"
        or t == "playerDetectorBlock"
        or t == "player_detector_block" then
            return peripheral.wrap(name), name
        end
    end
    return nil, nil
end

local detector, detName = findPlayerDetector()
if not detector then
    print("Player Detector not found. Available peripherals:")
    for _, name in ipairs(peripheral.getNames()) do
        print(string.format("  %s -> %s", name, tostring(peripheral.getType(name))))
    end
    error("Player Detector not found.")
end
print("Detected Player Detector: " .. tostring(detName))

local monitor = peripheral.find("monitor")
if not monitor then
    error("Monitor not found. Connect a monitor to the computer.")
end
pcall(function() monitor.setTextScale(0.5) end)

-- ------------------------------------------------------------
-- 2. Settings
-- ------------------------------------------------------------
local settings = {
    mode = "range",         -- "range" or "all"
    range = 100,
    interval = 1,
    showDimension = true,
}

-- ------------------------------------------------------------
-- 3. Safe helpers
-- ------------------------------------------------------------
local function toNum(v) return tonumber(v) or 0 end

local function shortStr(s, maxLen)
    s = tostring(s or "?")
    maxLen = maxLen or 16
    if #s > maxLen then s = s:sub(1, maxLen - 3) .. "..." end
    return s
end

local function touchSupported()
    local ok, methods = pcall(function()
        return peripheral.getMethods(peripheral.getName(monitor))
    end)
    if not ok or type(methods) ~= "table" then return false end
    for _, m in ipairs(methods) do
        if m == "getTouchMode" or m == "setTouchMode" then return true end
    end
    return false
end

local HAS_TOUCH = touchSupported()

-- ------------------------------------------------------------
-- 4. Data fetching
-- ------------------------------------------------------------
local function getPlayers()
    local ok, players
    if settings.mode == "range" then
        -- try all known method names
        local methods = { "getPlayersInRange", "getPlayersInCoords", "getOnlinePlayers" }
        for _, m in ipairs(methods) do
            ok, players = pcall(function()
                return detector[m](settings.range)
            end)
            if ok and type(players) == "table" then break end
            ok, players = nil, nil
        end
    else
        ok, players = pcall(function() return detector.getOnlinePlayers() end)
    end
    if not ok or type(players) ~= "table" then return {} end
    return players
end

local function getPlayerPos(username)
    local ok, data = pcall(function() return detector.getPlayerPos(username) end)
    if not ok or type(data) ~= "table" then return nil end
    return {
        x = toNum(data.x),
        y = toNum(data.y),
        z = toNum(data.z),
        dimension = tostring(data.dimension or "?"),
    }
end

-- ------------------------------------------------------------
-- 5. Monitor rendering
-- ------------------------------------------------------------
local BTN = {
    ALL   = { y = 4 },
    RANGE = { y = 5 },
    MINUS = { y = 6 },
    PLUS  = { y = 6 },
}

local function drawButton(y, text, active)
    monitor.setCursorPos(1, y)
    if active then
        monitor.setBackgroundColour(colors.green)
        monitor.setTextColour(colors.black)
    else
        monitor.setBackgroundColour(colors.grey)
        monitor.setTextColour(colors.white)
    end
    monitor.write(text)
    monitor.setBackgroundColour(colors.black)
    monitor.setTextColour(colors.white)
end

local function render()
    pcall(function()
        monitor.setBackgroundColour(colors.black)
        monitor.setTextColour(colors.white)
        monitor.clear()
    end)

    monitor.setCursorPos(1, 1)
    monitor.setTextColour(colors.yellow)
    monitor.write("=== Player Coordinates ===")

    monitor.setCursorPos(1, 2)
    monitor.setTextColour(colors.lightGrey)
    if settings.mode == "all" then
        monitor.write("Mode: ALL PLAYERS")
    else
        monitor.write(string.format("Mode: RANGE (radius %d)", settings.range))
    end

    drawButton(BTN.ALL.y,   "[ ALL PLAYERS ]", settings.mode == "all")
    drawButton(BTN.RANGE.y, "[ RANGE ONLY  ]", settings.mode == "range")

    monitor.setCursorPos(1, BTN.MINUS.y)
    monitor.setBackgroundColour(colors.grey)
    monitor.setTextColour(colors.white)
    monitor.write("[-] range")
    monitor.setCursorPos(14, BTN.MINUS.y)
    monitor.write("[+] range")
    monitor.setCursorPos(26, BTN.MINUS.y)
    monitor.setTextColour(colors.lightGrey)
    monitor.write(string.format("= %d", settings.range))
    monitor.setBackgroundColour(colors.black)
    monitor.setTextColour(colors.white)

    monitor.setCursorPos(1, 7)
    monitor.setTextColour(colors.grey)
    monitor.write(string.rep("-", 38))

    local players = getPlayers()

    if #players == 0 then
        monitor.setCursorPos(1, 9)
        monitor.setTextColour(colors.red)
        monitor.write("No players found.")
    else
        local line = 8
        monitor.setCursorPos(1, line)
        monitor.setTextColour(colors.cyan)
        monitor.write(string.format("%-16s %6s %6s %6s", "Player", "X", "Y", "Z"))
        line = line + 1

        monitor.setCursorPos(1, line)
        monitor.setTextColour(colors.grey)
        monitor.write(string.rep("-", 38))
        line = line + 1

        for _, username in ipairs(players) do
            if line > 19 then
                monitor.setCursorPos(1, line)
                monitor.setTextColour(colors.yellow)
                monitor.write("... (more players)")
                break
            end

            local pos = getPlayerPos(username)
            monitor.setCursorPos(1, line)
            monitor.setTextColour(colors.white)

            if pos then
                monitor.write(string.format("%-16s %6d %6d %6d",
                    shortStr(username, 16), pos.x, pos.y, pos.z))
            else
                monitor.setTextColour(colors.red)
                monitor.write(string.format("%-16s %s", shortStr(username, 16), "N/A"))
            end
            line = line + 1

            if settings.showDimension and pos then
                monitor.setCursorPos(1, line)
                monitor.setTextColour(colors.lightGrey)
                monitor.write("  -> " .. shortStr(pos.dimension, 34))
                line = line + 1
            end
        end
    end

    monitor.setCursorPos(1, 20)
    monitor.setTextColour(colors.grey)
    monitor.write("Updated: " .. os.date("%H:%M:%S") ..
        (HAS_TOUCH and "  (touch to switch)" or ""))
end

-- ------------------------------------------------------------
-- 6. Touch handling
-- ------------------------------------------------------------
local function handleTouch(side, x, y)
    if side ~= peripheral.getName(monitor) then return end

    if y == BTN.ALL.y then
        settings.mode = "all"
    elseif y == BTN.RANGE.y then
        settings.mode = "range"
    elseif y == BTN.MINUS.y then
        if x <= 12 then
            settings.range = math.max(1, settings.range - 10)
        elseif x >= 14 then
            settings.range = math.min(10000, settings.range + 10)
        end
    end
    render()
end

-- ------------------------------------------------------------
-- 7. Terminal menu
-- ------------------------------------------------------------
local function showMenu()
    print()
    print("========== CONTROLS ==========")
    print(string.format(" Current mode: %s", settings.mode))
    print(string.format(" Current range: %d", settings.range))
    print(" 1. Mode: ALL players")
    print(" 2. Mode: RANGE only")
    print(" 3. Range -10")
    print(" 4. Range +10")
    print(" 5. Set range manually")
    print(" 6. Exit")
    print("==============================")
    write("Choose: ")
end

local function handleTerminalChoice()
    local choice = read()

    if choice == "1" then
        settings.mode = "all"
    elseif choice == "2" then
        settings.mode = "range"
    elseif choice == "3" then
        settings.range = math.max(1, settings.range - 10)
    elseif choice == "4" then
        settings.range = math.min(10000, settings.range + 10)
    elseif choice == "5" then
        write("Enter new range: ")
        local v = tonumber(read())
        if v and v > 0 then settings.range = v end
    elseif choice == "6" then
        return false
    else
        print("Invalid choice.")
    end

    render()
    return true
end

-- ------------------------------------------------------------
-- 8. Main
-- ------------------------------------------------------------
print("Player Coordinates Display started.")
print(string.format("Detector: %s", tostring(detName)))
print(string.format("Monitor:  %s | Touch: %s",
    tostring(peripheral.getName(monitor)),
    HAS_TOUCH and "yes" or "no"))
if not HAS_TOUCH then
    print("Monitor does not support touch. Use the terminal menu.")
end

render()

local running = true

local function refreshLoop()
    while running do
        sleep(settings.interval)
        render()
    end
end

local function inputLoop()
    while running do
        showMenu()
        if not handleTerminalChoice() then
            running = false
            return
        end
    end
end

local function monitorLoop()
    while running do
        local event, side, x, y = os.pullEvent()
        if event == "monitor_touch" then
            handleTouch(side, x, y)
        elseif event == "terminate" then
            running = false
            return
        end
    end
end

parallel.waitForAny(refreshLoop, inputLoop, monitorLoop)
